# Gemini API Key (get yours at https://aistudio.google.com/apikey). Note: The VITE_ prefix is required for client-side access.
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# Deployment mode: 'open' (default) or 'preloaded'
DEPLOY_MODE=open

# For preloaded mode: GCS bucket with family reference photos
# GCS_BUCKET=gs://your-bucket/characters/

# Private deployment URL (for obscure URL security)
# DEPLOY_URL_PRIVATE=https://your-obscure-url.run.app
